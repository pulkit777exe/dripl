# Dockerfile for both backend services on Google Cloud Run
# Usage: docker build -f docker/Dockerfile.cloudrun --target http-server -t dripl-http .
#        docker build -f docker/Dockerfile.cloudrun --target ws-server -t dripl-ws .

# Base stage with all dependencies
FROM node:20-slim AS base
WORKDIR /app

RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

RUN corepack enable pnpm

# Copy workspace config
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./

# Copy package.json files
COPY packages/common/package.json      ./packages/common/
COPY packages/db/package.json          ./packages/db/
COPY packages/math/package.json        ./packages/math/
COPY packages/element/package.json     ./packages/element/
COPY packages/test-utils/package.json  ./packages/test-utils/
COPY packages/utils/package.json       ./packages/utils/
COPY apps/http-server/package.json     ./apps/http-server/
COPY apps/ws-server/package.json       ./apps/ws-server/
COPY tooling/typescript-config/package.json ./tooling/typescript-config/
COPY tooling/eslint-config/package.json ./tooling/eslint-config/

# Install dependencies
ENV PRISMA_SKIP_POSTINSTALL_GENERATE=true
ENV CI=true
RUN pnpm install --frozen-lockfile --network-concurrency 8

# Copy packages source
COPY packages/ ./packages/
COPY tooling/  ./tooling/
# Both apps build through scripts/bundle-server.mjs, which their build scripts
# reach at ../../scripts/, so this copy is a build prerequisite. Without it the
# builder stages below fail with ERR_MODULE_NOT_FOUND.
COPY scripts/  ./scripts/

# Generate Prisma client
RUN pnpm --filter @dripl/db exec prisma generate --schema=./prisma/schema.prisma

# Build shared packages before either application source is copied. The
# application-specific builder stages below compile the selected service.
RUN pnpm turbo run build --filter='!http-server' --filter='!ws-server'

# ==================== http-server ====================
FROM base AS http-builder
COPY apps/http-server/ ./apps/http-server/
RUN pnpm turbo run build --filter=http-server
# Production-only install tree: the bundle inlines all workspace source, so the
# runner needs just the app plus prod third-party deps (no devDeps, no workspace
# source, no pnpm needed at runtime). The runner below copies this tree, not the
# development node_modules from `base`, which would ship typescript, vitest,
# eslint, prisma and prisma studio into the deployed image.
RUN pnpm --filter http-server --prod deploy --legacy /prod/http-server
# Drop build/dev-time weight that ships inside @prisma/client's dependency
# closure but is never imported at runtime (proven: none of these appear in
# dist/index.js externals): the TS compiler, Prisma CLI + studio, effect,
# pglite, and engine binaries (migrate/generate run in the deps stage above).
RUN rm -rf /prod/http-server/node_modules/.pnpm/typescript@* \
  /prod/http-server/node_modules/.pnpm/prisma@7* \
  /prod/http-server/node_modules/.pnpm/@prisma+studio-core@* \
  /prod/http-server/node_modules/.pnpm/effect@* \
  /prod/http-server/node_modules/.pnpm/@electric-sql+pglite@* \
  /prod/http-server/node_modules/.pnpm/@prisma+engines@* \
  /prod/http-server/node_modules/typescript \
  /prod/http-server/node_modules/prisma

FROM node:20-slim AS http-server
ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

COPY --from=http-builder /prod/http-server ./apps/http-server

WORKDIR /app/apps/http-server

RUN chown -R node:node /app

USER node

ENV PORT=8080

EXPOSE 8080

CMD ["node", "dist/index.js"]

# ==================== ws-server ====================
FROM base AS ws-builder
COPY apps/ws-server/ ./apps/ws-server/
RUN pnpm turbo run build --filter=ws-server
# See the http-builder stage above: prod-only tree, and the same prune list.
RUN pnpm --filter ws-server --prod deploy --legacy /prod/ws-server
RUN rm -rf /prod/ws-server/node_modules/.pnpm/typescript@* \
  /prod/ws-server/node_modules/.pnpm/prisma@7* \
  /prod/ws-server/node_modules/.pnpm/@prisma+studio-core@* \
  /prod/ws-server/node_modules/.pnpm/effect@* \
  /prod/ws-server/node_modules/.pnpm/@electric-sql+pglite@* \
  /prod/ws-server/node_modules/.pnpm/@prisma+engines@* \
  /prod/ws-server/node_modules/typescript \
  /prod/ws-server/node_modules/prisma

FROM node:20-slim AS ws-server
ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

COPY --from=ws-builder /prod/ws-server ./apps/ws-server

WORKDIR /app/apps/ws-server

RUN chown -R node:node /app

USER node

ENV WS_PORT=8080

EXPOSE 8080

CMD ["node", "dist/index.js"]
