DATABASE_URL=postgresql://dripl:dripl@localhost:5432/dripl

# Must be different from INTERNAL_SECRET — used for signing JWTs
JWT_SECRET=change-this-to-a-random-32-character-string-minimum

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3002/api
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Analytics delivery endpoint for apps/dripl-app. Vendor-neutral on purpose: point
# it at whatever ingest URL you use and the JSON payload shape in
# apps/dripl-app/utils/analytics.ts is the contract. Leave it unset and events are
# only logged locally — nothing leaves the browser. Events are gated on the
# `dripl-cookie-consent` localStorage flag and never carry the URL fragment (which
# holds the E2EE decryption key) or the query string.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://ingest.example.com/v1/events
FRONTEND_URL=http://localhost:3000

GEMINI_API_KEY=

DEBUG_PRISMA=false
# Development-only escape hatch; keep false for remote databases.
DB_ALLOW_INSECURE_TLS=false
# Set true only behind a trusted proxy that overwrites forwarded IP headers.
TRUST_PROXY=false

NODE_ENV=development

HTTP_PORT=3002
WS_PORT=3001

SMTP_USER="your-gmail-address"
SMTP_PASS="your-app-password-here"
GOOGLE_CLIENT_ID="your-oauth2-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-oauth2-client-secret"

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Must be different from JWT_SECRET — used for server-to-server auth
INTERNAL_SECRET=
HTTP_SERVER_URL=http://localhost:3002
API_SERVER_URL=http://localhost:3002
IMAGE_STORAGE_DIR=./uploads/images

# Room ownership (ws-server). Enabled automatically whenever Redis is
# configured; set to `off` to disable the lease and fall back to the
# single-instance behaviour. See ADR-002 in AGENTS.md.
# WS_ROOM_OWNERSHIP=off

# Tunables. The value shown is the default the code falls back to.
LOG_LEVEL=info                  # error | warn | info
PERIODIC_SAVE_INTERVAL_MS=15000 # how often a live room is flushed to Postgres
ACCESS_RECHECK_THROTTLE_MS=30000
DB_POOL_SIZE=20

# Image object storage (optional).
#
# Leave both bucket variables unset and images stay on the local filesystem
# above — that is the default and needs no other setting here. Setting exactly
# one of IMAGE_S3_BUCKET or IMAGE_FIREBASE_BUCKET switches apps/http-server to
# that driver. Setting BOTH is refused at startup rather than resolved by a
# precedence rule, because during a migration the two overlap and a silent
# choice would write new images to the store you are trying to leave.
#
# A configured-but-unreachable store fails loudly rather than falling back, so
# a typo cannot silently split images across two backends.
#
# --- S3-compatible: Backblaze B2 (current), also AWS S3 / R2 / MinIO ---
#
# B2 speaks the S3 REST API, so it uses this same driver and these same keys.
# There is deliberately no separate B2 driver and no provider branch in the
# request path: the only thing that changes between providers is endpoint,
# region and addressing style, and all three are set here.
#
# Take these from the B2 console under the bucket's "App Keys" page. The
# application key is the SECRET_ACCESS_KEY; there is no separate AWS-style
# secret to look for.
#
# REGION and ENDPOINT must agree, and the pairing is the one thing here that
# fails confusingly: the region is part of the SigV4 credential scope *and* of
# the endpoint host, so a mismatch signs a request that looks well-formed and is
# refused as SignatureDoesNotMatch rather than as a bad host. ENDPOINT is
# therefore written as the same region string, not as a separate literal.
#
# For AWS S3 instead: set REGION to your AWS region and leave ENDPOINT empty —
# it defaults to s3.<REGION>.amazonaws.com. For Cloudflare R2: REGION=auto and
# ENDPOINT=https://<account>.r2.cloudflarestorage.com.
#
# BOTH BLANK IS NOT A NO-OP. Leaving REGION and ENDPOINT empty resolves to
# region `us-east-1` and host `s3.us-east-1.amazonaws.com` — AWS, not B2. Measured
# through resolveImageStoreConfig, not assumed. With B2 credentials that is a signed
# request to the wrong vendor, and the failure names neither the bucket nor the
# region. So on B2, fill both in; the bucket's own page is where the region is.
IMAGE_S3_BUCKET=
IMAGE_S3_REGION=
IMAGE_S3_ENDPOINT=
IMAGE_S3_PATH_STYLE=true
IMAGE_S3_ACCESS_KEY_ID=
IMAGE_S3_SECRET_ACCESS_KEY=
# Only for temporary/short-lived credentials (STS, instance roles).
# B2 application keys are long-lived and leave this empty.
IMAGE_S3_SESSION_TOKEN=
IMAGE_S3_TIMEOUT_MS=5000
#
# --- Firebase Storage ---
# Uses the Firebase REST API directly; no `firebase-admin` dependency is added.
# Needs a service account (Firebase console > Project settings > Service
# accounts) holding a Storage role on the bucket below. Put the values from its
# JSON in PRIVATE_KEY; the `\n` escapes are unwrapped automatically, so pasting
# the whole `private_key` field works. Never commit a real key.
#
# ENDPOINT is left empty for production. Set it to http://127.0.0.1:9199 to use
# the local Firebase emulator instead.
IMAGE_FIREBASE_BUCKET=
IMAGE_FIREBASE_CLIENT_EMAIL=
IMAGE_FIREBASE_PRIVATE_KEY=
IMAGE_FIREBASE_ENDPOINT=
# Object-name prefix each image is written under. No ".." segment.
IMAGE_FIREBASE_PREFIX=images
IMAGE_FIREBASE_TIMEOUT_MS=5000
