DATABASE_URL=postgresql://dripl:dripl@localhost:5432/dripl

# Must be different from INTERNAL_SECRET — used for signing JWTs
JWT_SECRET=change-this-to-a-random-32-character-string-minimum

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3002/api
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Analytics delivery endpoint for apps/dripl-app. Vendor-neutral on purpose: point
# it at whatever ingest URL you use and the JSON payload shape in
# apps/dripl-app/utils/analytics.ts is the contract. Leave it unset and events are
# only logged locally — nothing leaves the browser. Events are gated on the
# `dripl-cookie-consent` localStorage flag and never carry the URL fragment (which
# holds the E2EE decryption key) or the query string.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://ingest.example.com/v1/events
FRONTEND_URL=http://localhost:3000

GEMINI_API_KEY=

DEBUG_PRISMA=false
# Development-only escape hatch; keep false for remote databases.
DB_ALLOW_INSECURE_TLS=false
# Set true only behind a trusted proxy that overwrites forwarded IP headers.
TRUST_PROXY=false

NODE_ENV=development

HTTP_PORT=3002
WS_PORT=3001

SMTP_USER="your-gmail-address"
SMTP_PASS="your-app-password-here"
GOOGLE_CLIENT_ID="your-oauth2-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-oauth2-client-secret"

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Must be different from JWT_SECRET — used for server-to-server auth
INTERNAL_SECRET=
HTTP_SERVER_URL=http://localhost:3002
API_SERVER_URL=http://localhost:3002
IMAGE_STORAGE_DIR=./uploads/images

# Room ownership (ws-server). Enabled automatically whenever Redis is
# configured; set to `off` to disable the lease and fall back to the
# single-instance behaviour. See ADR-002 in AGENTS.md.
# WS_ROOM_OWNERSHIP=off

# Tunables. The value shown is the default the code falls back to.
LOG_LEVEL=info                  # error | warn | info
PERIODIC_SAVE_INTERVAL_MS=15000 # how often a live room is flushed to Postgres
ACCESS_RECHECK_THROTTLE_MS=30000
DB_POOL_SIZE=20

# Image object storage (optional).
#
# Leave IMAGE_S3_BUCKET unset and images stay on the local filesystem above —
# that is the default and needs no other setting here. Setting IMAGE_S3_BUCKET
# switches apps/http-server to the S3-compatible driver, which also serves
# Cloudflare R2, MinIO and Backblaze B2 by changing the endpoint and path style.
# A configured-but-unreachable store fails loudly rather than falling back, so
# a typo cannot silently split images across two backends.
#
# AWS S3: leave ENDPOINT empty.  R2/MinIO/B2: set ENDPOINT to the bucket URL.
IMAGE_S3_BUCKET=
IMAGE_S3_REGION=us-east-1
IMAGE_S3_ENDPOINT=
IMAGE_S3_PATH_STYLE=true
IMAGE_S3_ACCESS_KEY_ID=
IMAGE_S3_SECRET_ACCESS_KEY=
# Only for temporary/short-lived credentials (STS, instance roles).
IMAGE_S3_SESSION_TOKEN=
IMAGE_S3_TIMEOUT_MS=5000
