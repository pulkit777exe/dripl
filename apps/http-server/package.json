{
  "name": "http-server",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "build": "node ../../scripts/bundle-server.mjs",
    "dev": "node ../../scripts/ensure-prisma-client.mjs && dotenv -e ../../.env.local -e ../../.env -- tsx watch --tsconfig tsconfig.dev.json src/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "check-types": "tsc --noEmit -p tsconfig.check.json",
    "health": "curl -f http://localhost:${HTTP_PORT:-3002}/health || exit 1",
    "bench:http": "tsx bench/http-path.bench.ts"
  },
  "dependencies": {
    "@dripl/common": "workspace:*",
    "@dripl/db": "workspace:*",
    "@dripl/utils": "workspace:*",
    "@sentry/node": "^10.76.2",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dripl/eslint-config": "workspace:*",
    "@dripl/typescript-config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.2",
    "dotenv-cli": "^8.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
