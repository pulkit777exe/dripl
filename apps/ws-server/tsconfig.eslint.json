{
  // Lint-only project for apps/ws-server. See tooling/eslint-config/index.js
  // for why these files exist and why `@dripl/*` is mapped to source here.
  // `*.ts` in `include` is the root-level `vitest.config.ts`, which the build
  // tsconfig does not cover but `eslint .` does lint. `@/*` is inherited from
  // the build config and must be repeated here because `paths` is replaced
  // wholesale rather than merged.
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@/*": ["./src/*"],
      "@dripl/common": ["../../packages/common/src/index.ts"],
      "@dripl/common/arrow-binding": ["../../packages/common/src/arrow-binding.ts"],
      "@dripl/common/reconciliation": ["../../packages/common/src/reconciliation.ts"],
      "@dripl/db": ["../../packages/db/src/index.ts"],
      "@dripl/utils/logger": ["../../packages/utils/src/logger.ts"]
    }
  }
}
