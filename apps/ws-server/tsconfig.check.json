// Type-check-only config for `pnpm check-types`.
//
// Same shape as packages/*/tsconfig.check.json: it extends the real tsconfig so
// it inherits the strictness, but it turns `composite` and `incremental` off and
// never emits. Nothing references this file, so it is deliberately outside the
// `tsc -b` graph — that is what keeps a check from ever writing into dist/ and
// clobbering the esbuild bundle in scripts/bundle-server.mjs.
//
// The `paths` map is what makes the check work on a fresh checkout. Without it,
// `@dripl/*` resolves through each workspace package's `exports` map, whose
// `types` condition points at dist/*.d.ts — files that do not exist until
// `pnpm build` has run. Mapping them to workspace source instead means
// `pnpm check-types` passes on a tree that has never been built.
//
// `paths` REPLACES the inherited map rather than merging with it (verified with
// tsc --showConfig), which is why `@/*` has to be restated here even though
// tsconfig.json already declares it.
//
// `exclude` is deliberately not overridden to `[]` the way packages/*/tsconfig.*
// .check.json do: this tsconfig has no `exclude`, and blanking the field would
// drop TypeScript's default `node_modules` exclusion. Tests already live under
// `include: ["src"]`, so nothing needs re-including.
//
// `rootDir` is inherited as "src" only to satisfy the composite build, and the
// `paths` map above legitimately puts files outside it, which is TS6059. That
// constraint exists to compute emit locations, and this config emits nothing, so
// it is re-rooted at the repository root where both apps/ and packages/ live.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@/*": ["./src/*"],
      "@dripl/common": ["../../packages/common/src/index.ts"],
      "@dripl/common/constants": ["../../packages/common/src/constants.ts"],
      "@dripl/common/schemas": ["../../packages/common/src/schemas.ts"],
      "@dripl/common/arrow-binding": ["../../packages/common/src/arrow-binding.ts"],
      "@dripl/common/cascade-delete": ["../../packages/common/src/cascade-delete.ts"],
      "@dripl/common/reconciliation": ["../../packages/common/src/reconciliation.ts"],
      "@dripl/common/types/element": ["../../packages/common/src/types/element.ts"],
      "@dripl/common/types/user": ["../../packages/common/src/types/user.ts"],
      "@dripl/db": ["../../packages/db/src/index.ts"],
      "@dripl/utils": ["../../packages/utils/src/index.ts"],
      "@dripl/utils/auth": ["../../packages/utils/src/auth.ts"],
      "@dripl/utils/env": ["../../packages/utils/src/env.ts"],
      "@dripl/utils/logger": ["../../packages/utils/src/logger.ts"],
      "@dripl/utils/encryption": ["../../packages/utils/src/encryption/index.ts"]
    }
  }
}
