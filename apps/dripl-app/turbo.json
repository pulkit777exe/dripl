{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tags": ["app:web"],
  "tasks": {
    "build": {
      "description": "Build Next.js app with precise env hashing",
      "env": ["NEXT_PUBLIC_*"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/.env.local",
        "$TURBO_ROOT$/.env.production",
        "$TURBO_ROOT$/.env.production.local"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "test": {
      // No `env` key here on purpose. Turbo REPLACES an inherited task `env`
      // array rather than merging it, so naming only NEXT_PUBLIC_* and
      // GEMINI_API_KEY silently dropped DATABASE_URL and RUN_DB_INTEGRATION
      // from every test process in this package. The DB-backed suites then
      // skipped themselves with no failure and no log, which reads exactly
      // like a passing run. Inheriting the root list keeps one source of
      // truth for what tests can see.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/.env.test",
        "$TURBO_ROOT$/.env.test.local"
      ]
    }
  }
}
