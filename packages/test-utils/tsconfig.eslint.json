{
  // Lint-only project for packages/test-utils. See tooling/eslint-config/index.js
  // for why these files exist and why `@dripl/*` is mapped to source here.
  // `*.ts` in `include` is the root-level `vitest.config.ts`, which the build
  // tsconfig does not cover but `eslint .` does lint. `exclude` REPLACES the
  // build config's list, which is what un-covers `src/**/*.test.ts`.
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@dripl/common": ["../common/src/index.ts"]
    }
  }
}
