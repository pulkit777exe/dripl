{
  "name": "@dripl/math",
  "version": "0.0.0",
  "description": "Math utilities for geometry and intersection calculations",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "default": "./dist/geometry.js"
    },
    "./intersection": {
      "types": "./dist/intersection.d.ts",
      "default": "./dist/intersection.js"
    }
  },
  "scripts": {
    "build": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest run",
    "check-types": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "@dripl/common": "workspace:*"
  },
  "devDependencies": {
    "@dripl/eslint-config": "workspace:*",
    "@dripl/typescript-config": "workspace:*",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
