{
  "name": "@dripl/element",
  "version": "0.0.0",
  "description": "Element factory and rendering for Dripl canvas",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./staticScene": {
      "types": "./dist/staticScene.d.ts",
      "default": "./dist/staticScene.js"
    },
    "./resizeElements": {
      "types": "./dist/resizeElements.d.ts",
      "default": "./dist/resizeElements.js"
    },
    "./shape-cache": {
      "types": "./dist/shape-cache.d.ts",
      "default": "./dist/shape-cache.js"
    },
    "./mutateElement": {
      "types": "./dist/mutateElement.d.ts",
      "default": "./dist/mutateElement.js"
    },
    "./image-cache": {
      "types": "./dist/image-cache.d.ts",
      "default": "./dist/image-cache.js"
    },
    "./freedraw": {
      "types": "./dist/freedraw.d.ts",
      "default": "./dist/freedraw.js"
    },
    "./rough-renderer": {
      "types": "./dist/rough-renderer.d.ts",
      "default": "./dist/rough-renderer.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    }
  },
  "scripts": {
    "build": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest run",
    "bench:render": "tsx bench/render-path.bench.ts",
    "bench:pixels": "tsx bench/pixel-diff.ts --selftest",
    "bench:cache": "tsx bench/cache-retention.ts",
    "bench:walk": "tsx bench/cache-walk.ts",
    "check-types": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "@dripl/common": "workspace:*",
    "@dripl/math": "workspace:*",
    "perfect-freehand": "^1.2.3",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@dripl/eslint-config": "workspace:*",
    "@dripl/test-utils": "workspace:*",
    "@dripl/typescript-config": "workspace:*",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "fast-check": "^3.23.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
